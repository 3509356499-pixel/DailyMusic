<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>歌曲主页</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden;
        }
        body {
            font-family: "Microsoft YaHei", -apple-system, sans-serif;
            color: #fff;
            background-color: #000;
            background-image: url("");
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            transition: opacity 0.6s ease;
            cursor: pointer;
        }
        .info-wrap {
            transition: opacity 0.4s ease, transform 0.4s ease;
        }
        .fade-out {
            opacity: 0;
        }
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background: rgba(10, 10, 15, 0.55);
            z-index: 0;
            pointer-events: none;
        }
        .info-wrap {
            position: fixed;
            z-index: 1;
            left: 4%;
            bottom: 12%;
            width: 25vw;
        }
        .info-wrap h2 {
            margin: 0 0 16px;
            font-size: clamp(32px, 4vw, 48px);
            letter-spacing: 0.8px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
        }
        .chips {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 10px;
            margin-bottom: 20px;
        }
        .chip {
            font-size: 14px;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f0f0f0;
            white-space: nowrap;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
        }
        .chip b {
            color: #ffce5c;
            font-weight: 600;
        }
        .score {
            color: #ffb400;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 18px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.75);
        }
        .desc {
            font-size: 16px;
            line-height: 1.8;
            color: #f5f5f5;
            margin-bottom: 28px;
            text-shadow: 0 1px 6px rgba(0, 0, 0, 0.75);
        }
        .btns {
            display: flex;
            gap: 12px;
        }
        button {
            padding: 13px 30px;
            border: none;
            border-radius: 999px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;
        }
        button:active {
            transform: scale(0.96);
        }
        #playBtn {
            background: linear-gradient(135deg, #4caf50, #3c9c40);
            color: #fff;
            box-shadow: 0 6px 18px rgba(76, 175, 80, 0.35);
        }
        #playBtn:hover {
            background: linear-gradient(135deg, #5cc962, #45b04a);
            box-shadow: 0 8px 22px rgba(76, 175, 80, 0.5);
        }
        #refreshBtn {
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.22);
        }
        #refreshBtn:hover {
            background: rgba(255, 255, 255, 0.24);
        }
        @media (max-width: 900px) {
            .info-wrap { width: 40vw; }
        }
        @media (max-width: 640px) {
            .info-wrap {
                left: 5%;
                width: 90vw;
                bottom: 8%;
            }
            .info-wrap h2 {
                font-size: clamp(26px, 7vw, 36px);
            }
        }
    </style>
</head>
<body>
    <div class="info-wrap">
        <h2 id="songTitle">加载中...</h2>
        <div class="chips">
            <span class="chip" id="yearChip"></span>
            <span class="chip" id="tagChip"></span>
        </div>
        <div class="chips">
            <span class="chip">作词：<b id="lyricistText"></b></span>
            <span class="chip">作曲：<b id="composerText"></b></span>
        </div>
        <div class="score" id="scoreText"></div>
        <div class="desc" id="descText"></div>
        <div class="btns">
            <button id="playBtn">▶ 播放</button>
            <button id="refreshBtn">换一首</button>
        </div>
    </div>

<script>
    let songData = null;

    async function loadSong() {
        try {
            // 先淡出
            document.body.classList.add('fade-out');
            document.querySelector('.info-wrap').style.opacity = 0;
            document.querySelector('.info-wrap').style.transform = 'translateY(10px)';
            
            setTimeout(async () => {
                const res = await fetch("/api/music_xue/random_songs");
                if (!res.ok) {
                    throw new Error(`请求失败: ${res.status}`);
                }
                songData = await res.json();

                // 封面路径容错：修正笔误
                if (songData.bg === '/cover1.jp') songData.bg = '/cover1.jpg';

                document.body.style.backgroundImage = `url("${songData.bg}")`;
                document.getElementById("songTitle").innerText = songData.title;
                document.getElementById("yearChip").innerText = songData.year;
                document.getElementById("tagChip").innerText = songData.tag;
                document.getElementById("lyricistText").innerText = songData.lyricist;
                document.getElementById("composerText").innerText = songData.composer;
                document.getElementById("scoreText").innerText = `⭐ ${songData.score}`;
                document.getElementById("descText").innerText = songData.desc;

                // 淡入
                document.body.classList.remove('fade-out');
                setTimeout(() => {
                    document.querySelector('.info-wrap').style.opacity = 1;
                    document.querySelector('.info-wrap').style.transform = 'translateY(0)';
                }, 100);
            }, 400);
        } catch (err) {
            console.error("加载歌曲失败:", err);
            document.getElementById("songTitle").innerText = "加载失败，请检查后端服务";
        }
    }

    // 跳详情页公共方法
    function goToDetail() {
        if (!songData) return;
        const query = new URLSearchParams({
            id: songData.id,
            title: songData.title,
            bg: songData.bg,
            year: songData.year,
            tag: songData.tag,
            lyricist: songData.lyricist,
            composer: songData.composer,
            score: songData.score,
            desc: songData.desc,
            audio: songData.audio
        });
        location.href = `detail.html?${query.toString()}`;
    }

    // 点击播放按钮进详情
    document.getElementById("playBtn").onclick = function (e) {
        e.stopPropagation();
        goToDetail();
    };

    // 点击换歌按钮阻止冒泡
    document.getElementById("refreshBtn").onclick = function (e) {
        e.stopPropagation();
        loadSong();
    };

    // 点击背景图任意位置（除了按钮）也能进详情
    document.body.addEventListener('click', function() {
        goToDetail();
    });

    window.onload = loadSong;
</script>
</body>
</html>





